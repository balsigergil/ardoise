{
  "name": "ardoise",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "pnpm --filter @ardoise/e2e test",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:spdx": "node scripts/check-spdx.mjs",
    "db:migrate": "pnpm --filter @ardoise/db run migrate",
    "db:generate": "pnpm --filter @ardoise/db run generate"
  },
  "devDependencies": {
    "@ardoise/config": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
