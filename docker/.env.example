# Copy to docker/.env and replace every value marked "change me".
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

ARDOISE_PUBLIC_URL=http://localhost:3000
ARDOISE_SECRET_KEY=change-me-at-least-32-characters-long
POSTGRES_PASSWORD=change-me
S3_ACCESS_KEY=ardoise
S3_SECRET_KEY=change-me

# Optional: create the first super-admin at boot instead of using the setup URL.
# ARDOISE_ADMIN_EMAIL=admin@example.org
# ARDOISE_ADMIN_PASSWORD=change-me-too

# Optional: host port of the app (default 3000).
# ARDOISE_PORT=3000
