{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "ARDOISE_*",
        "DATABASE_URL",
        "VALKEY_URL",
        "S3_*",
        "SMTP_*",
        "PORT",
        "HOST",
        "LOG_*"
      ]
    }
  }
}
